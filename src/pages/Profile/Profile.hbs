<section class="profile">
  <div class="profile__card">
    <nav class="profile__nav">
      <a class="profile__back-link" href="{{chatUrl}}">← Назад к чатам</a>
    </nav>

    <header class="profile__top">
      <div class="profile__avatar">
        {{#if avatarUrl}}
          <img class="profile__avatar-image" src="{{avatarUrl}}" alt="Аватар пользователя {{fullName}}" />
        {{else}}
          <div class="profile__avatar-fallback"></div>
        {{/if}}
      </div>
      <h1 class="profile__name">{{fullName}}</h1>
    </header>

    <dl class="profile__details">
      {{#each details}}
        <div class="profile__detail-row">
          <dt class="profile__detail-label">{{label}}</dt>
          <dd class="profile__detail-value">{{value}}</dd>
        </div>
      {{/each}}
    </dl>

    <div class="profile__actions">
      {{{openEditButton}}}
      {{{openPasswordButton}}}
    </div>

    {{{editModal}}}
    {{{passwordModal}}}
    {{{logoutButton}}}
  </div>
</section>
