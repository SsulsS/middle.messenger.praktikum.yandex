<header class="chat__top">
  <div class="chat__title-block">
    <div class="chat__title-avatar" aria-hidden="true"></div>
    <div class="chat__title-info">
      <h2 class="chat__title">{{title}}</h2>
      {{#if status}}
        <p class="chat__title-status">{{status}}</p>
      {{/if}}
    </div>
  </div>
</header>
