<section class="form-page {{pageClass}}">
  <div class="form-page__container {{containerClass}}">
    <h2 class="form-page__title">{{title}}</h2>
    <form class="form-page__form" novalidate>
      {{#each fields}}
        <div class="form-page__field">
          <label class="form-page__label" for="{{id}}">{{label}}</label>
          <input
            id="{{id}}"
            name="{{name}}"
            type="{{type}}"
            placeholder="{{placeholder}}"
            class="form-page__input"
            aria-label="{{label}}"
            {{#if autocomplete}}autocomplete="{{autocomplete}}"{{/if}}
          />
          <span class="form-page__error form-page__error_{{name}}" aria-live="polite"></span>
        </div>
      {{/each}}

      <button type="submit" class="form-page__button">{{submitText}}</button>

      {{#if link}}
        <a href="{{link.href}}" class="form-page__link">{{link.text}}</a>
      {{/if}}
    </form>
  </div>
</section>
