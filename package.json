{
  "name": "chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "npm run build && vite preview --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint:js": "eslint . --ext .ts --fix",
    "lint:css": "stylelint \"src/**/*.scss\" --fix",
    "lint": "npm run lint:js && npm run lint:css",
    "test": "vitest"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.57.0",
    "stylelint": "^15.11.0",
    "stylelint-config-standard-scss": "^11.1.0",
    "typescript": "~6.0.2",
    "vitest": "^1.3.0",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "handlebars": "^4.7.9",
    "sass": "^1.99.0"
  }
}
