{
  "name": "chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "npm run build && vite preview",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint:js": "eslint . --ext .ts",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:types": "tsc --noEmit",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:types",
    "lint:fix": "eslint . --ext .ts --fix && stylelint \"src/**/*.scss\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.{ts,cjs,json}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "handlebars": "4.7.10"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "stylelint": "18.0.0",
    "stylelint-config-standard-scss": "18.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
